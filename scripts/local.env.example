# scripts/local.env.example -- copy to scripts/local.env (not tracked by git) to fix your settings once.  See scripts/env.sh for what each one means.
PROFILE=full
SEEDS=0-4              # 0-6 for seven seeds
# RUNS=runs/full        # default: runs/$PROFILE
DEVICE=cuda            # cpu if you have no GPU
JOBS=4
WORKERS=4              # one run uses WORKERS cores for the proof search; JOBS runs at once need about JOBS x WORKERS cores
# CORES=16
# MEM_GB=48
# SET="rl_iters=20 eval_probes=1000"
