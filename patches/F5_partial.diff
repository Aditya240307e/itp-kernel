+/// The first `n` entries of an environment. A hypothesis's stored type is anchored at the depth it was
+/// introduced at (its own index), so it must be evaluated in THAT prefix: a lambda or Pi inside it captures
+/// the environment it is evaluated in, and when later re-quoted its binder is placed at env.size(). Evaluating
+/// in the full environment instead (Finding F5) makes that position too high, so an embedded binder collides
+/// with a later hypothesis (e.g. the `h` in `h : Ex (fun x => x = m)`).
+inline Env env_prefix(const Env& e, uint32_t n) {
+    Env r;
+    for (uint32_t i = 0; i < n; ++i) r = r.extend(e[i]);
+    return r;
+}
